# ==============================================================================
# Backend Environment Variables (DROID FastAPI)
# ==============================================================================

# Authentication (Supabase JWT secret for token validation)
AUTH_REQUIRED=false
SUPABASE_JWT_SECRET=changeme

# Database (PostgreSQL/Supabase connection string)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Market Data Provider (mock / fyers / upstox)
MARKET_DATA_PROVIDER=mock

# OpenRouter AI — Dynamic Free-Model System (Settings-driven, no hardcode required)
# PRIMARY: Settings → AI Engine → OpenRouter (stored in localStorage + Supabase). No .env needed.
# FALLBACK (optional): Server default for shared deployments — leave empty if using Settings UI.
# Get key at https://openrouter.ai/keys → sk-or-v1-...
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=true
OPENROUTER_MODEL_CACHE_MINUTES=10
OPENROUTER_DEFAULT_MODEL=auto
