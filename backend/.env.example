# ==============================================================================
# Backend Environment Variables (DROID FastAPI)
# ==============================================================================

# Authentication (Supabase JWT secret for token validation)
# PRODUCTION: AUTH_REQUIRED must be true + SUPABASE_JWT_SECRET set via secret manager.
# Never commit real secrets — backend/.env (localhost) only.
APP_MODE=development
AUTH_REQUIRED=false
SUPABASE_JWT_SECRET=changeme

# Database (PostgreSQL/Supabase connection string)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Market Data Provider — FYERS ONLY (Truth-of-Wall)
# API_TYPE is fixed to "indian", MARKET_DATA_PROVIDER fixed to "fyers".
# No other broker is supported; all LTP/candles/option-chain come from FYERS API v3.
API_TYPE=indian
MARKET_DATA_PROVIDER=fyers

# FYERS Gateway (LOCALHOST-ONLY — sole source is backend/.env, never Settings UI)
# App ID format: ClientID-100 (e.g., XC12345-100)
# FYERS_REDIRECT_URI must match Fyers MyAPI dashboard exactly.
# Backend runs on http://127.0.0.1:8000, frontend stays on https://fo-droid.web.app
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/v1/tokens/fyers/callback
FYERS_ACCESS_TOKEN=

# Redis & Caching (optional — in-memory used when empty)
REDIS_URL=

# Telegram Integration (§2) — bot token is secret, never committed, never exposed to the frontend
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Public @username of the bot (without @)
TELEGRAM_BOT_USERNAME=
# Secret token set via setWebhook and verified on every webhook update (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this backend — localhost-only.
# Telegram webhook will NOT work on localhost without an https tunnel.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# OpenRouter AI — Dynamic Free-Model System (Settings-driven, no hardcode required)
# PRIMARY: Settings → AI Engine → OpenRouter (stored in localStorage + Supabase). No .env needed.
# FALLBACK (optional): Server default for shared deployments — leave empty if using Settings UI.
# Get key at https://openrouter.ai/keys → sk-or-v1-...
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=true
OPENROUTER_MODEL_CACHE_MINUTES=10
OPENROUTER_DEFAULT_MODEL=auto
